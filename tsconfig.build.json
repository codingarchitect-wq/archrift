{
  // The package's lib/: the command line, server and analyzers as JavaScript, for
  // installs from npm (Node won't strip types under node_modules). The viewer is
  // built by Vite into dist/ instead.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/cli/**/*.ts", "src/core/**/*.ts", "src/server/**/*.ts", "src/analyzer/**/*.ts"]
}
